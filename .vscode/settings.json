{
  "C_Cpp.default.compilerPath": "g++",
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.intelliSenseMode": "linux-gcc-x64",
  "C_Cpp.errorSquiggles": "enabled",
  "files.associations": {
    "*.h": "cpp",
    "*.hpp": "cpp"
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.analysis.typeCheckingMode": "basic",
  "editor.formatOnSave": true,
  "C_Cpp.clang_format_path": "/home/chery/.local/bin/clang-format",
  "clang-format.executable": "/home/chery/.local/bin/clang-format",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit",
      "source.fixAll.ruff": "explicit"
    }
  },
  "ruff.nativeServer": "on",

  // Code Runner：在编辑器右上角添加 ▶ 运行按钮
  "code-runner.runInTerminal": true,
  "code-runner.saveFileBeforeRun": true,
  "code-runner.ignoreSelection": true,
  "code-runner.clearPreviousOutput": true,
  "code-runner.executorMap": {
    "cpp": "cmake --build --preset debug --target $fileNameWithoutExt && \"$workspaceRoot/build/bin/$fileNameWithoutExt\""
  }
}
